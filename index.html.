<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Daveziko Games</title>

    <meta
        name="description"
        content="Daveziko Games — jeux vidéo et projets de Dave Ziko."
    >

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #050505;
            color: white;
            overflow-x: hidden;
        }

        /* =========================
           INTRO
        ========================= */

        #intro {
            position: fixed;
            inset: 0;
            z-index: 9999;
            background: #000;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            transition: opacity 1s ease, visibility 1s ease;
        }

        #intro.hidden {
            opacity: 0;
            visibility: hidden;
        }

        .intro-content {
            width: 90%;
            max-width: 700px;
        }

        .intro-logo {
            font-size: clamp(55px, 12vw, 120px);
            font-weight: 900;
            letter-spacing: 12px;
            color: white;
            text-shadow:
                0 0 10px rgba(255,255,255,0.7),
                0 0 30px rgba(255,255,255,0.4);
            animation: logoIn 1.5s ease forwards;
        }

        .intro-subtitle {
            margin-top: 15px;
            font-size: clamp(14px, 3vw, 22px);
            letter-spacing: 8px;
            color: #999;
            opacity: 0;
            animation: subtitleIn 1s ease forwards;
            animation-delay: 1s;
        }

        .loader {
            width: 220px;
            max-width: 70%;
            height: 3px;
            margin: 45px auto 0;
            background: #222;
            overflow: hidden;
            border-radius: 10px;
        }

        .loader-bar {
            width: 0%;
            height: 100%;
            background: white;
            animation: loading 3s ease forwards;
            animation-delay: 1.2s;
        }

        @keyframes logoIn {
            0% {
                opacity: 0;
                transform: scale(0.7);
                letter-spacing: 30px;
            }

            100% {
                opacity: 1;
                transform: scale(1);
                letter-spacing: 12px;
            }
        }

        @keyframes subtitleIn {
            0% {
                opacity: 0;
                transform: translateY(20px);
            }

            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes loading {
            0% {
                width: 0%;
            }

            100% {
                width: 100%;
            }
        }

        /* =========================
           BACKGROUND
        ========================= */

        .background {
            position: fixed;
            inset: 0;
            z-index: -2;
            background:
                radial-gradient(
                    circle at 20% 20%,
                    rgba(255,255,255,0.06),
                    transparent 25%
                ),
                radial-gradient(
                    circle at 80% 80%,
                    rgba(255,255,255,0.04),
                    transparent 25%
                ),
                #050505;
        }

        .grid {
            position: fixed;
            inset: 0;
            z-index: -1;
            opacity: 0.08;
            background-image:
                linear-gradient(#fff 1px, transparent 1px),
                linear-gradient(90deg, #fff 1px, transparent 1px);
            background-size: 50px 50px;
            pointer-events: none;
        }

        /* =========================
           HEADER
        ========================= */

        header {
            position: sticky;
            top: 0;
            z-index: 1000;
            width: 100%;
            padding: 20px 7%;
            background: rgba(0,0,0,0.75);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255,255,255,0.08);

            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .brand {
            font-size: 22px;
            font-weight: 900;
            letter-spacing: 3px;
        }

        nav {
            display: flex;
            gap: 25px;
        }

        nav a {
            color: #aaa;
            text-decoration: none;
            font-size: 14px;
            font-weight: bold;
            transition: 0.3s;
        }

        nav a:hover {
            color: white;
        }

        /* =========================
           HERO
        ========================= */

        .hero {
            min-height: 90vh;
            padding: 100px 7% 80px;

            display: flex;
            align-items: center;
            justify-content: center;

            text-align: center;
        }

        .hero-content {
            max-width: 900px;
        }

        .hero h1 {
            font-size: clamp(55px, 12vw, 130px);
            font-weight: 900;
            letter-spacing: 8px;
            line-height: 0.95;
        }

        .hero h2 {
            margin-top: 25px;
            font-size: clamp(18px, 4vw, 30px);
            letter-spacing: 6px;
            color: #999;
        }

        .hero p {
            max-width: 650px;
            margin: 30px auto 0;
            color: #aaa;
            line-height: 1.8;
            font-size: 16px;
        }

        .hero-button {
            display: inline-block;
            margin-top: 40px;
            padding: 16px 30px;

            color: #000;
            background: white;

            text-decoration: none;
            font-weight: 900;
            letter-spacing: 2px;

            border-radius: 6px;

            transition:
                transform 0.25s ease,
                box-shadow 0.25s ease;
        }

        .hero-button:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 35px rgba(255,255,255,0.2);
        }

        /* =========================
           SECTION
        ========================= */

        section {
            padding: 100px 7%;
        }

        .section-title {
            text-align: center;
            margin-bottom: 60px;
        }

        .section-title h2 {
            font-size: clamp(35px, 7vw, 65px);
            letter-spacing: 5px;
        }

        .section-title p {
            margin-top: 15px;
            color: #777;
        }

        /* =========================
           GAME CARD
        ========================= */

        .games-container {
            max-width: 1100px;
            margin: auto;

            display: grid;
            grid-template-columns: repeat(
                auto-fit,
                minmax(280px, 1fr)
            );

            gap: 30px;
        }

        .game-card {
            position: relative;
            padding: 35px;

            background: linear-gradient(
                145deg,
                #151515,
                #080808
            );

            border: 1px solid #292929;
            border-radius: 15px;

            overflow: hidden;

            transition:
                transform 0.3s ease,
                border-color 0.3s ease,
                box-shadow 0.3s ease;
        }

        .game-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;

            width: 100%;
            height: 3px;

            background: white;

            transform: scaleX(0);
            transform-origin: left;

            transition: transform 0.3s ease;
        }

        .game-card:hover {
            transform: translateY(-8px);
            border-color: #555;
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        }

        .game-card:hover::before {
            transform: scaleX(1);
        }

        .game-icon {
            width: 80px;
            height: 80px;

            display: flex;
            align-items: center;
            justify-content: center;

            margin-bottom: 25px;

            border: 1px solid #444;
            border-radius: 15px;

            font-size: 40px;

            background: #0b0b0b;
        }

        .game-card h3 {
            font-size: 30px;
            margin-bottom: 12px;
        }

        .game-card .version {
            display: inline-block;
            margin-bottom: 20px;

            padding: 6px 10px;

            border: 1px solid #444;
            border-radius: 5px;

            font-size: 11px;
            letter-spacing: 2px;
            color: #aaa;
        }

        .game-card p {
            color: #999;
            line-height: 1.7;
            margin-bottom: 25px;
        }

        .game-button {
            display: inline-block;

            padding: 12px 20px;

            background: white;
            color: black;

            border-radius: 5px;

            text-decoration: none;
            font-weight: bold;

            transition: 0.25s;
        }

        .game-button:hover {
            transform: translateY(-2px);
            opacity: 0.85;
        }

        /* =========================
           ABOUT
        ========================= */

        .about {
            max-width: 850px;
            margin: auto;
            text-align: center;
        }

        .about p {
            color: #999;
            line-height: 2;
            font-size: 17px;
        }

        /* =========================
           FOOTER
        ========================= */

        footer {
            padding: 50px 7%;
            border-top: 1px solid #1c1c1c;
            text-align: center;
            color: #666;
        }

        footer strong {
            color: white;
        }

        /* =========================
           MOBILE
        ========================= */

        @media (max-width: 650px) {

            header {
                padding: 18px 5%;
            }

            .brand {
                font-size: 17px;
            }

            nav {
                gap: 12px;
            }

            nav a {
                font-size: 11px;
            }

            .hero {
                padding: 80px 5%;
            }

            section {
                padding: 75px 5%;
            }

            .intro-logo {
                letter-spacing: 5px;
            }

            .intro-subtitle {
                letter-spacing: 4px;
            }

            .game-card {
                padding: 25px;
            }
        }
    </style>
</head>

<body>

    <!-- =========================
         INTRO
    ========================= -->

    <div id="intro">
        <div class="intro-content">

            <div class="intro-logo">
                DAVEZIKO
            </div>

            <div class="intro-subtitle">
                GAMES STUDIO
            </div>

            <div class="loader">
                <div class="loader-bar"></div>
            </div>

        </div>
    </div>

    <!-- BACKGROUND -->

    <div class="background"></div>
    <div class="grid"></div>

    <!-- =========================
         HEADER
    ========================= -->

    <header>

        <div class="brand">
            DAVEZIKO
        </div>

        <nav>
            <a href="#accueil">ACCUEIL</a>
            <a href="#jeux">JEUX</a>
            <a href="#apropos">À PROPOS</a>
        </nav>

    </header>

    <!-- =========================
         HERO
    ========================= -->

    <main>

        <section class="hero" id="accueil">

            <div class="hero-content">

                <h1>
                    DAVEZIKO
                </h1>

                <h2>
                    GAMES
                </h2>

                <p>
                    Bienvenue sur mon espace de développement.
                    Ici tu retrouveras mes jeux, mes projets
                    et les différentes versions de mes créations.
                </p>

                <a
                    class="hero-button"
                    href="#jeux"
                >
                    VOIR MES JEUX
                </a>

            </div>

        </section>

        <!-- =========================
             GAMES
        ========================= -->

        <section id="jeux">

            <div class="section-title">

                <h2>
                    MES JEUX
                </h2>

                <p>
                    Découvrez mes projets actuels.
                </p>

            </div>

            <div class="games-container">

                <!-- DARKSNAKE -->

                <article class="game-card">

                    <div class="game-icon">
                        🐍
                    </div>

                    <h3>
                        DarkSnake
                    </h3>

                    <span class="version">
                        V1.0 — BETA
                    </span>

                    <p>
                        Un Snake revisité avec une ambiance
                        sombre, des bonus, des pièces,
                        des skins et plusieurs niveaux.
                    </p>

                    <a
                        class="game-button"
                        href="https://daveziko.itch.io/darksnake-v1-beta"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        JOUER
                    </a>

                </article>

                <!-- FUTUR JEU -->

                <article class="game-card">

                    <div class="game-icon">
                        🎮
                    </div>

                    <h3>
                        PROCHAIN PROJET
                    </h3>

                    <span class="version">
                        BIENTÔT
                    </span>

                    <p>
                        Un nouveau projet est actuellement
                        en préparation. Il arrivera prochainement
                        sur Daveziko Games.
                    </p>

                    <span
                        class="game-button"
                        style="opacity:0.4; cursor:not-allowed;"
                    >
                        BIENTÔT
                    </span>

                </article>

            </div>

        </section>

        <!-- =========================
             ABOUT
        ========================= -->

        <section id="apropos">

            <div class="section-title">

                <h2>
                    À PROPOS
                </h2>

            </div>

            <div class="about">

                <p>
                    Daveziko Games est mon espace personnel
                    consacré à la création de jeux vidéo.
                    Je développe mes projets étape par étape
                    et je partage ici leurs différentes versions.
                </p>

            </div>

        </section>

    </main>

    <!-- =========================
         FOOTER
    ========================= -->

    <footer>

        <p>
            © 2026 <strong>Daveziko Games</strong>
        </p>

        <p style="margin-top:10px;">
            Tous mes projets, au même endroit.
        </p>

    </footer>

    <!-- =========================
         INTRO SCRIPT
    ========================= -->

    <script>

        window.addEventListener("load", function () {

            const intro = document.getElementById("intro");

            setTimeout(function () {

                intro.classList.add("hidden");

                document.body.style.overflow = "auto";

            }, 4700);

        });

    </script>

</body>
</html>
