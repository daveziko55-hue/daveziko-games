<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daveziko Games</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #050505;
            color: white;
            font-family: Arial, sans-serif;
            overflow-x: hidden;
        }

        /* =========================
           ÉCRAN D'INTRO
        ========================= */

        #intro {
            position: fixed;
            inset: 0;
            background: #000;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            z-index: 9999;
            animation: introOut 1s ease 3.5s forwards;
        }

        .logo {
            font-size: clamp(40px, 8vw, 90px);
            font-weight: 900;
            letter-spacing: 8px;
            text-align: center;
            text-shadow:
                0 0 10px #00ffff,
                0 0 25px #00ffff,
                0 0 50px #0066ff;
            animation: logoIn 1.5s ease forwards,
                       pulse 1.5s ease-in-out 1.5s infinite alternate;
        }

        .subtitle {
            margin-top: 20px;
            font-size: 16px;
            letter-spacing: 5px;
            color: #aaa;
            opacity: 0;
            animation: subtitleIn 1s ease 1s forwards;
        }

        .loader {
            width: 180px;
            height: 3px;
            background: #222;
            margin-top: 35px;
            overflow: hidden;
        }

        .loader span {
            display: block;
            width: 0;
            height: 100%;
            background: #00ffff;
            box-shadow: 0 0 15px #00ffff;
            animation: loading 2.5s ease forwards;
        }

        @keyframes logoIn {
            from {
                opacity: 0;
                transform: scale(0.5);
                filter: blur(15px);
            }

            to {
                opacity: 1;
                transform: scale(1);
                filter: blur(0);
            }
        }

        @keyframes subtitleIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes pulse {
            from {
                transform: scale(1);
            }

            to {
                transform: scale(1.04);
            }
        }

        @keyframes loading {
            to {
                width: 100%;
            }
        }

        @keyframes introOut {
            to {
                opacity: 0;
                visibility: hidden;
                pointer-events: none;
            }
        }

        /* =========================
           SITE
        ========================= */

        header {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 30px;
            background:
                radial-gradient(circle at center, #101c2c 0%, #050505 55%, #000 100%);
        }

        .hero h1 {
            font-size: clamp(45px, 8vw, 100px);
            letter-spacing: 6px;
            margin-bottom: 20px;
        }

        .hero p {
            color: #aaa;
            font-size: 20px;
            margin-bottom: 35px;
        }

        .button {
            display: inline-block;
            padding: 15px 30px;
            border: 1px solid #00ffff;
            border-radius: 8px;
            color: #00ffff;
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
            box-shadow: 0 0 15px rgba(0, 255, 255, 0.2);
        }

        .button:hover {
            background: #00ffff;
            color: #000;
            box-shadow: 0 0 30px rgba(0, 255, 255, 0.6);
            transform: translateY(-3px);
        }

        section {
            padding: 80px 8%;
        }

        .section-title {
            font-size: 40px;
            margin-bottom: 40px;
            text-align: center;
        }

        .games {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 30px;
            max-width: 1100px;
            margin: auto;
        }

        .game-card {
            background: #0d0d0d;
            border: 1px solid #222;
            border-radius: 15px;
            padding: 30px;
            transition: 0.3s;
        }

        .game-card:hover {
            transform: translateY(-8px);
            border-color: #00ffff;
            box-shadow: 0 0 25px rgba(0, 255, 255, 0.15);
        }

        .game-card h3 {
            font-size: 28px;
            margin-bottom: 15px;
        }

        .game-card p {
            color: #999;
            line-height: 1.6;
            margin-bottom: 25px;
        }

        footer {
            text-align: center;
            padding: 40px;
            border-top: 1px solid #222;
            color: #666;
        }

        @media (max-width: 600px) {
            .logo {
                letter-spacing: 4px;
            }

            .hero p {
                font-size: 17px;
            }

            section {
                padding: 60px 20px;
            }
        }
    </style>
</head>

<body>

    <!-- INTRO -->
    <div id="intro">
        <div class="logo">DAVEZIKO</div>
        <div class="subtitle">GAMES STUDIO</div>

        <div class="loader">
            <span></span>
        </div>
    </div>

    <!-- ACCUEIL -->
    <header>
        <div class="hero">
            <h1>DAVEZIKO GAMES</h1>

            <p>
                Bienvenue dans mon univers de jeux.
            </p>

            <a href="#games" class="button">
                🎮 VOIR MES JEUX
            </a>
        </div>
    </header>

    <!-- JEUX -->
    <section id="games">
        <h2 class="section-title">🎮 MES JEUX</h2>

        <div class="games">

            <div class="game-card">
                <h3>🐍 DarkSnake</h3>

                <p>
                    DarkSnake V1.0 — BETA<br>
                    Mon premier jeu disponible en test.
                </p>

                <a
                    class="button"
                    href="https://daveziko.itch.io/darksnake-v1-beta"
                    target="_blank"
                >
                    📥 TÉLÉCHARGER
                </a>
            </div>

        </div>
    </section>

    <!-- PIED DE PAGE -->
    <footer>
        © 2026 Daveziko Games — Tous droits réservés.
    </footer>

</body>
</html>
